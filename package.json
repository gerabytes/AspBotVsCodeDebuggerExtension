{
	"name": "aspbot-debug",
	"displayName": "AspBot Debug",
	"version": "0.1.2",
	"publisher": "Gerabytes",
	"description": "AspBot VsCode Debugger Extension",
	"author": {
		"name": "Gerabytes Ltda.",
		"email": "contato@gerabytes.ai"
	},
	"license": "CC BY-NC-ND 4.0",
	"keywords": [
		"multi-root ready"
	],
	"engines": {
		"vscode": "^1.44.0"
	},
	"icon": "images/icoaspbot.png",
	"categories": [
		"Debuggers"
	],
	"private": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/gerabytes/AspBotVsCodeDebuggerExtension.git"
	},
	"bugs": {
		"url": "https://github.com/gerabytes/AspBotVsCodeDebuggerExtension/issues"
	},
	"scripts": {
		"prepublish": "tsc -p ./src",
		"compile": "tsc -p ./src",
		"tslint": "tslint ./src/**/*.ts",
		"watch": "tsc -w -p ./src",
		"test": "mocha -u tdd ./out/tests/",
		"package": "vsce package",
		"publish": "vsce publish"
	},
	"dependencies": {
		"await-notify": "1.0.1",
		"vscode-debugadapter": "1.40.0",
		"websocket": "^1.0.31"
	},
	"devDependencies": {
		"@types/node": "10.12.12",
		"@types/mocha": "5.2.7",
		"@types/vscode": "^1.44.0",
		"typescript": "3.5.3",
		"mocha": "6.2.0",
		"vscode-debugadapter-testsupport": "1.40.3",
		"tslint": "5.18.0",
		"vsce": "1.74.0"
	},
	"main": "./out/extension",
	"activationEvents": [
		"onDebug",
		"onDebugDynamicConfigurations:aspbot",
		"onCommand:extension.aspbot-debug.getProgramName"
	],
	"contributes": {
		"breakpoints": [
			{
				"language": "html"
			}
		],
		"debuggers": [
			{
				"type": "aspbot",
				"label": "AspBot Debug",
				"program": "./out/debugAdapter.js",
				"runtime": "node",
				"configurationAttributes": {
					"launch": {
						"required": [
							"program"
						],
						"properties": {
							"program": {
								"type": "string",
								"description": "Absolute path to a text file.",
								"default": "${workspaceFolder}/${command:AskForProgramName}"
							},
							"stopOnEntry": {
								"type": "boolean",
								"description": "Automatically stop after launch.",
								"default": true
							},
							"trace": {
								"type": "boolean",
								"description": "Enable logging of the Debug Adapter Protocol.",
								"default": true
							}
						}
					}
				},
				"initialConfigurations": [
					{
						"type": "aspbot",
						"request": "launch",
						"name": "AspBot Debugger",
						"program": "^\"\\${file}\"",
						"stopOnEntry": false
					}
				],
				"configurationSnippets": [
					{
						"label": "AspBot Debug: Launch",
						"description": "A new configuration for 'debugging' a AspBot Script.",
						"body": {
							"type": "aspbot",
							"request": "launch",
							"name": "AspBot Debugger",
							"program": "^\"\\${file}\"",
							"stopOnEntry": true
						}
					}
				],
				"variables": {
					"AskForProgramName": "extension.aspbot-debug.getProgramName"
				}
			}
		]
	}
}
